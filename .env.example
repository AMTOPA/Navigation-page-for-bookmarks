APP_NAME=Edge 收藏导航
DATABASE_URL=sqlite:////app/backend/data/bookmarks.db
SECRET_KEY=请替换为至少32字节的随机字符串
ENCRYPTION_KEY=请使用 Fernet.generate_key 生成
ADMIN_USERNAME=admin
# 仅首次创建管理员时需要；创建完成后可以删除此行。
ADMIN_PASSWORD=请设置高强度初始密码
SESSION_DAYS=14
SECURE_COOKIES=true
FRONTEND_DIR=/app/frontend
DATA_DIR=/app/backend/data
MAX_UPLOAD_MB=20
MAX_ATTACHMENT_MB=100
CRAWL_TIMEOUT_SECONDS=15
DISPLAY_TIMEZONE=Asia/Shanghai

# 邮箱验证码登录/重置密码。收件邮箱限制在后端校验，不要放到前端。
ALLOWED_LOGIN_EMAIL=3314982394@qq.com
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_IP_COOLDOWN_SECONDS=60
DENYLIST_PATH=/opt/deny/denylist.txt
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=sender@example.com
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=12
